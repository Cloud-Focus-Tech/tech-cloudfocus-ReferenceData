# Copy this file to .env in the project root and fill in your local values.
# .env is ignored by Git. Keep this example free of credentials.
# Use KEY=value without export or surrounding quotes.
# Parsed as Java properties: escape a literal backslash as \\.

CONNECTION_URL=
CONNECTION_USERNAME=
CONNECTION_PASSWORD=
STORAGE_ACCOUNT_NAME=
STORAGE_ACCOUNT_KEY=
STORAGE_CONNECTION_STRING=
STORAGE_CONTAINER_NAME=reference-data
# Positive milliseconds between checks; 300000 = five minutes. Restart after changes.
STORAGE_REFRESH_INTERVAL_MS=300000
# Browser origins allowed to call the API; comma-separated, without paths or trailing slashes.
# For local Backstage, use http://localhost:3000.
CORS_ALLOWED_ORIGINS=https://developer.lab.cloudfocus.tech
