		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>tech.cloudfocus</groupId>
	<artifactId>ReferenceData</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
